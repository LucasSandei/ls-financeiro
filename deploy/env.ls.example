
# ------------------------------------------------------------------
# LS Financeiro (acrescentado ao .env do Bigcapital)
# ------------------------------------------------------------------

# Domínios apontados (registro A) para o IP da VPS
DOMINIO_APP=financeiro.seudominio.com.br
DOMINIO_WHATSAPP=whatsapp.seudominio.com.br
EMAIL_SSL=seu-email@exemplo.com

# WhatsApp (Evolution API)
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_INSTANCE=financeiro

# Agente
AGENTE_WEBHOOK_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# Transcrição de áudio (opcional). Groq tem plano gratuito:
# TRANSCRIPTION_API_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3
